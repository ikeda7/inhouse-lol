// ---------------------------------------------------------------------------
// InHouse LoL - schema Prisma (SQLite)
//
// NOTA IMPORTANTE SOBRE ENUMS:
// O provider `sqlite` do Prisma NAO suporta `enum`. Todos os campos que
// conceitualmente sao enums (Role, TeamSide, SeriesStatus, MatchSource) sao
// gravados como String. A fonte da verdade dos valores validos fica em
// `server/src/lib/roles.ts` e `server/src/lib/enums.ts`, e a validacao
// acontece na borda da API (zod). Se um dia migrar para PostgreSQL, esses
// campos viram enums reais sem mudanca de dados.
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Jogador do grupo.
model Player {
  id             String   @id @default(cuid())
  name           String   @unique
  /// Riot ID no formato "Nick#TAG". Opcional: da pra registrar partida manual sem ele.
  riotId         String?  @unique
  /// PUUID resolvido pela Account-V1. Cacheado para nao gastar rate limit toda hora.
  puuid          String?  @unique
  /// Rating interno usado pelo auto-balance. 1000 = neutro (estilo Elo simplificado).
  internalRating Int      @default(1000)
  /// Jogador inativo nao aparece na tela de sorteio, mas mantem o historico.
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  /// Pool de roles. Ordem definida por `PlayerRole.priority` (0 = role principal).
  roles PlayerRole[]
  stats MatchPlayerStat[]

  burnedChampions BurnedChampion[]

  @@index([active])
}

/// Pool de posicoes de um jogador, normalizado.
///
/// Preferi a tabela de ligacao ao inves de um campo `mainRoles` em CSV porque o
/// algoritmo de auto-balance precisa da ORDEM de preferencia (o array do seed ja
/// vem ordenado: ["Jungle","Top","ADC"] = Jungle e a main) e porque permite
/// consultar "quem joga Support?" sem LIKE em string.
///
/// `role` aceita TOP | JUNGLE | MID | ADC | SUPPORT | FILL.
/// FILL e gravado como uma unica linha e expandido para as 5 roles em memoria.
model PlayerRole {
  id       String @id @default(cuid())
  playerId String
  role     String
  /// 0 = role principal, 1 = secundaria, ...
  priority Int    @default(0)

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, role])
  @@index([role])
}

/// A "noite de jogos": uma MD3 (melhor de 3).
model Series {
  id     String   @id @default(cuid())
  date   DateTime @default(now())
  /// Rotulo opcional, ex: "Quarta 05/03".
  name   String?
  /// ONGOING | FINISHED | CANCELLED
  status String   @default("ONGOING")
  /// BLUE | RED | NONE (NONE = encerrada sem vencedor definido)
  winnerTeam String?
  /// Placar agregado da serie (2-0, 2-1, ...). Mantido denormalizado para o
  /// historico nao precisar agregar Match em toda listagem.
  blueScore Int @default(0)
  redScore  Int @default(0)
  /// Se false, o Fearless Draft fica desligado nessa serie (campeoes se repetem).
  fearless  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  matches         Match[]
  burnedChampions BurnedChampion[]

  @@index([date])
  @@index([status])
}

/// Um jogo unico dentro da serie.
///
/// Nao existe modelo `Team`: os times sao formados na hora e mudam a cada jogo,
/// entao a composicao vive em `MatchPlayerStat.teamSide` (BLUE/RED). Um modelo
/// Team persistido geraria centenas de times de uma partida so.
model Match {
  id          String @id @default(cuid())
  seriesId    String
  /// 1, 2 ou 3 dentro da MD3.
  matchNumber Int
  /// ID da partida na Riot (ex: "BR1_1234567890"), quando veio da API.
  riotMatchId String? @unique
  /// BLUE | RED. Null enquanto o jogo esta em andamento.
  winner      String?
  gameDurationSec Int?
  playedAt    DateTime @default(now())
  /// RIOT_API | MANUAL
  source      String   @default("MANUAL")

  /// Patch em que a partida foi jogada (ex: "16.17.810.4348"). Serve para a UI
  /// pedir os icones do Data Dragon da versao certa, e nao da mais recente.
  gameVersion String?
  /// Rendicao encerra o jogo antes da hora e distorce dano/farm por minuto.
  /// Guardado para a tela poder avisar em vez de comparar numeros incomparaveis.
  surrendered Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  series Series            @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  stats  MatchPlayerStat[]
  teams  MatchTeamStat[]
  bans   MatchBan[]

  @@unique([seriesId, matchNumber])
  @@index([seriesId])
}

/**
 * Objetivos por time.
 *
 * Sao dados de TIME, nao de jogador: dragao nao pertence a quem deu o last hit.
 * Ficam em tabela separada em vez de virarem blueDragons/redDragons no Match,
 * porque assim a consulta e a UI tratam os dois lados pelo mesmo caminho.
 */
model MatchTeamStat {
  id      String @id @default(cuid())
  matchId String
  /// BLUE | RED
  teamSide String
  win      Boolean

  towerKills      Int @default(0)
  inhibitorKills  Int @default(0)
  dragonKills     Int @default(0)
  baronKills      Int @default(0)
  riftHeraldKills Int @default(0)
  /// Larvas do Vazio (o LCU chama de hordeKills).
  voidgrubKills   Int @default(0)

  firstBlood     Boolean @default(false)
  firstTower     Boolean @default(false)
  firstInhibitor Boolean @default(false)
  firstBaron     Boolean @default(false)
  firstDragon    Boolean @default(false)

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([matchId, teamSide])
}

/**
 * Bans do draft de torneio (issue #8).
 *
 * O grupo joga com bans, e eles vinham no payload do cliente desde sempre --
 * so ninguem estava guardando. Sao diferentes do Fearless: ban e escolha de
 * quem draftou naquele jogo, campeao queimado e consequencia de ter sido usado.
 */
model MatchBan {
  id      String @id @default(cuid())
  matchId String
  /// BLUE | RED -- o time que baniu.
  teamSide String
  championId   Int
  championName String?
  /// Ordem do ban no draft (1 a 10).
  pickTurn Int

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([matchId, teamSide, pickTurn])
  @@index([matchId])
}

/// Linha da tabela de scoreboard: um jogador em um jogo.
model MatchPlayerStat {
  id       String @id @default(cuid())
  matchId  String
  playerId String

  /// BLUE | RED
  teamSide     String
  /// TOP | JUNGLE | MID | ADC | SUPPORT (role efetivamente jogada)
  rolePlayed   String
  championName String
  /// championId numerico da Riot; usado para casar com o Data Dragon.
  championId   Int?

  kills       Int @default(0)
  deaths      Int @default(0)
  assists     Int @default(0)
  /// totalDamageDealtToChampions
  damage      Int @default(0)
  damageTaken Int @default(0)
  goldEarned  Int @default(0)
  visionScore Int @default(0)
  /// minions + monstros abatidos
  cs          Int @default(0)

  win Boolean

  // --- destaques ---
  // Vem prontos do cliente do LoL; antes eram descartados na importacao.
  // Guardados por jogo (nao acumulados) para o historico saber em QUAL partida
  // a quadra aconteceu.
  doubleKills         Int @default(0)
  tripleKills         Int @default(0)
  quadraKills         Int @default(0)
  pentaKills          Int @default(0)
  /// Maior sequencia de abates sem morrer.
  largestKillingSpree Int @default(0)
  /// 2 = double, 3 = triple, 4 = quadra, 5 = penta.
  largestMultiKill    Int @default(0)
  firstBloodKill      Boolean @default(false)
  firstBloodAssist    Boolean @default(false)
  /// Quantas sequencias de abate, nao o tamanho da maior.
  killingSprees       Int @default(0)
  largestCriticalStrike Int @default(0)

  // --- o resto do scoreboard ---
  // Tudo isso vem pronto do cliente do LoL. Guardar aqui e o que permite montar
  // a tela de fim de partida sem o cliente aberto -- que e a razao de existir
  // destas colunas: dado de custom game so existe na maquina de quem jogou, e
  // depende do cliente ainda ter a partida em cache.
  champLevel          Int @default(0)
  goldSpent           Int @default(0)
  /// Dano a TODOS os alvos (o `damage` acima e so a campeoes).
  totalDamageDealt    Int @default(0)
  damageToObjectives  Int @default(0)
  damageToTurrets     Int @default(0)
  /// Dano absorvido por escudo, armadura e resistencia.
  damageSelfMitigated Int @default(0)
  totalHeal           Int @default(0)
  /// Quebra do dano a campeoes -- da para desenhar a proporcao AD/AP/verdadeiro.
  physicalDamageToChampions Int @default(0)
  magicDamageToChampions    Int @default(0)
  trueDamageToChampions     Int @default(0)
  /// Segundos de controle de grupo aplicados.
  timeCCingOthers     Int @default(0)
  /// Segundos vivo na maior sobrevida da partida.
  longestTimeSpentLiving Int @default(0)
  turretKills         Int @default(0)
  inhibitorKills      Int @default(0)
  wardsPlaced         Int @default(0)
  wardsKilled         Int @default(0)
  controlWardsBought  Int @default(0)
  /// `cs` acima soma os dois; separados dizem se o farm veio de rota ou selva.
  laneMinionsKilled    Int @default(0)
  neutralMinionsKilled Int @default(0)

  // --- build ---
  /// Os 7 slots de item em ordem, separados por virgula ("3084,1056,0,...").
  /// Zero = slot vazio. CSV em vez de tabela porque item e posicao fixa, nao
  /// entidade -- normalizar 7 inteiros ordenados nao compra nada.
  items         String?
  spell1Id      Int?
  spell2Id      Int?
  /// Runa principal (keystone) e as duas arvores.
  keystoneId    Int?
  primaryStyleId Int?
  subStyleId    Int?

  match  Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([matchId, playerId])
  @@index([playerId])
  @@index([championName])
}

/// Campeao "queimado" pelo Fearless Draft dentro de uma serie.
///
/// A unique em [seriesId, championName] e o que garante a regra: um campeao so
/// pode ser queimado uma vez por MD3. O upsert na hora de salvar o jogo torna a
/// operacao idempotente (re-sincronizar a mesma partida nao duplica nada).
model BurnedChampion {
  id                    String @id @default(cuid())
  seriesId              String
  championName          String
  championId            Int?
  /// Em qual jogo da MD3 o campeao foi usado (1, 2 ou 3).
  matchNumberWhenBurned Int
  /// Quem jogou e de que lado. Opcional: permite queimar manualmente no draft,
  /// antes do jogo existir.
  teamSide              String?
  playerId              String?

  createdAt DateTime @default(now())

  series Series  @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  player Player? @relation(fields: [playerId], references: [id], onDelete: SetNull)

  @@unique([seriesId, championName])
  @@index([seriesId])
}
