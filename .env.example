# ---------------------------------------------------------------------------
# InHouse LoL - variaveis de ambiente
#
# Copie para .env e preencha:   cp .env.example .env
# O .env esta no .gitignore. NUNCA comite a chave da Riot.
# ---------------------------------------------------------------------------

# --- Banco de dados -------------------------------------------------------
# Desenvolvimento: arquivo local (caminho relativo a server/prisma/).
DATABASE_URL="file:./dev.db"

# Producao com Turso (SQLite hospedado). Substitui a linha acima:
#   DATABASE_URL="libsql://seu-banco.turso.io"
#   DATABASE_AUTH_TOKEN="..."
# So o Turso exige token; arquivo local ignora.
DATABASE_AUTH_TOKEN=""

# --- Riot Games API -------------------------------------------------------
# Pegue em https://developer.riotgames.com/ (chave de desenvolvimento expira
# a cada 24h). OPCIONAL: sem ela o app roda 100% no modo de registro manual,
# so a sincronizacao automatica de partidas fica indisponivel.
RIOT_API_KEY=""

# Roteamento regional para Account-V1 e Match-V5: americas | europe | asia | sea
RIOT_REGIONAL_ROUTE="americas"

# Plataforma para Spectator-V5: br1 | na1 | euw1 | eun1 | kr | la1 | la2 | ...
RIOT_PLATFORM="br1"

# --- Servidor -------------------------------------------------------------
PORT="3333"
NODE_ENV="development"

# Origem liberada no CORS (o dev server do Vite).
CORS_ORIGIN="http://localhost:5173"

# --- Data Dragon ----------------------------------------------------------
# Idioma dos nomes de campeao nos assets: pt_BR | en_US | es_ES | ...
DDRAGON_LOCALE="pt_BR"

# --- Autenticacao (contas de jogador, issue #3) ----------------------------
# Assina o cookie de sessao. Em dev qualquer string serve; em producao gere
# um segredo de verdade, por exemplo com: openssl rand -hex 32
JWT_SECRET="dev-secret-troque-em-producao"

# Chave. Sem ADMIN_PLAYER_IDS ela e a chave do GRUPO: toda escrita exige a
# chave ou uma conta logada. Com ADMIN_PLAYER_IDS ela vira a chave do AGENTE:
# so abre a MD3 da noite e importa jogos, e fica apenas no PC do admin (o
# companion manda via INHOUSE_CHAVE). Vazia = escritas abertas. Em producao,
# DEFINA: o site e o repo sao publicos. Gere com: openssl rand -hex 16
GROUP_KEY=""

# Quem administra: ids de jogador (o "id" de /api/players), separados por
# virgula. Com pelo menos um, o site fica so de leitura para os outros: gravar
# exige a CONTA de um admin, e criar conta nova fica fechado (crie a do admin
# ANTES de por o id aqui). Vazia = sem admin, quem tem a chave ou uma conta
# pode tudo. Em producao, DEFINA.
ADMIN_PLAYER_IDS=""

# --- Frontend (Vite) ------------------------------------------------------
# Precisa do prefixo VITE_ para ser exposto ao browser.
# Cuidado: tudo com VITE_ vai para o bundle publico. Nunca coloque segredo aqui.
VITE_API_URL="http://localhost:3333/api"
